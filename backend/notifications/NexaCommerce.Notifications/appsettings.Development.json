{
  /*
    Notifications — appsettings.Development.json
    ─────────────────────────────────────────────
    When running via Aspire AppHost, ConnectionStrings:rabbitmq and
    ConnectionStrings:catalog-db are injected automatically.
    These values are only used when running `dotnet run` directly without Aspire.
  */
  "ConnectionStrings": {
    "catalog-db": "Host=localhost;Port=5432;Database=catalog;Username=postgres;Password=postgres",
    "rabbitmq":   "amqp://guest:guest@localhost:5672"
  },
  "Logging": {
    "LogLevel": {
      "Default":                    "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Wolverine":                  "Information"
    }
  }
}

