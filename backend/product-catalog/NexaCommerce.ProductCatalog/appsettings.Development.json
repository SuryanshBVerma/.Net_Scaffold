{
  /*
    ProductCatalog — appsettings.Development.json
    ──────────────────────────────────────────────
    Overrides for local development. These values are shared dev defaults.
    For personal overrides (e.g. different DB password) use User Secrets:
      dotnet user-secrets set "ConnectionStrings:catalog-db" "..."

    When running via Aspire AppHost, connection strings and Storage:ServiceUrl
    are INJECTED at startup by Aspire (overriding whatever is here).
    These values are only used when running `dotnet run` directly without Aspire.
  */
  "ConnectionStrings": {
    "catalog-db": "Host=localhost;Port=5432;Database=catalog;Username=postgres;Password=postgres"
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey":  "minioadmin",
    "SecretKey":  "minioadmin"
  },
  "Logging": {
    "LogLevel": {
      "Default":                       "Debug",
      "Microsoft.AspNetCore":          "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}

