{
  /*
    ReportScheduler — appsettings.Development.json
    ───────────────────────────────────────────────
    When running via Aspire AppHost, ConnectionStrings:scheduler-db and
    ConnectionStrings:rabbitmq are injected automatically.
    These values are only used when running `dotnet run` directly without Aspire.
  */
  "ConnectionStrings": {
    "scheduler-db": "Host=localhost;Port=5432;Database=catalog;Username=postgres;Password=postgres",
    "rabbitmq":     "amqp://guest:guest@localhost:5672"
  },
  "Logging": {
    "LogLevel": {
      "Default":                    "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz":                     "Information",
      "Wolverine":                  "Information"
    }
  }
}

