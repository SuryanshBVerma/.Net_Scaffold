{
  /*
    NexaCommerce.AppHost — appsettings.json
    ─────────────────────────────────────────
    Configuration read by Program.cs at startup.

    LEARNING: Aspire's DistributedApplication reads this via builder.Configuration,
    which is a standard IConfiguration backed by appsettings.json + environment
    variables. Environment variables override these values, making it easy to
    tune behaviour in CI without changing this file.

    Sensitive values (passwords, API keys) go in User Secrets in development:
      dotnet user-secrets set "Postgres:Password" "super-secret"
    Or in environment variables / Key Vault in production.
  */

  /*
    Aspire port allocation:
    Aspire assigns random free ports to avoid conflicts. The ports below are
    the HOST-side bindings for well-known management UIs that we want predictable.
    Service-to-service communication uses Aspire's service discovery — no hardcoded ports.
  */
  "Aspire": {
    "Dashboard": {
      "Port": 15888
    }
  },

  /*
    Logging configuration for the AppHost process itself (not the services).
    Each service has its own appsettings.json with its own log levels.
  */
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Aspire": "Debug"
    }
  },

  /*
    Image tags pinned here for reproducibility.
    When you want to upgrade PostgreSQL from 17 to 18, change one line here.

    LEARNING: Pinning image tags in config (not code) lets ops teams upgrade
    infrastructure versions without touching C# files.

    These values are NOT currently read by Program.cs — the image tags are
    hardcoded there for clarity. In a production setup you would read these
    via builder.Configuration["Images:Postgres"] to make upgrades a config change.
  */
  "Images": {
    "Postgres": "17-alpine",
    "RabbitMQ": "4-management-alpine",
    "Minio": "RELEASE.2025-04-22T22-12-26Z",
    "Traefik": "v3.3"
  },

  /*
    Well-known ports for management UIs.
    Actual service ports are assigned dynamically by Aspire.
  */
  "Ports": {
    "MinioS3Api": 9000,
    "MinioConsole": 9001,
    "RabbitMQManagement": 15672,
    "TraefikDashboard": 8080,
    "TraefikHttp": 80
  }
}
