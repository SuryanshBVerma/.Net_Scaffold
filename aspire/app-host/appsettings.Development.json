{
  /*
    NexaCommerce.AppHost — appsettings.Development.json
    ─────────────────────────────────────────────────────
    Overrides for the local development environment ONLY.
    This file is committed to git. Do NOT put real secrets here.

    LEARNING — What belongs here vs User Secrets:
      appsettings.Development.json  → dev defaults everyone on the team shares
                                      (e.g. "use pgAdmin", "enable Traefik dashboard")
      User Secrets                  → personal overrides (different passwords,
                                      local paths, feature flags for one developer)

    LEARNING — Why keep dev credentials in appsettings.Development.json at all?
      For local Dockerised infrastructure (Postgres, MinIO, RabbitMQ started by Aspire)
      the "credentials" are only valid on your laptop — there is no real data at risk.
      Having shared dev defaults means a new team member can `dotnet run` the AppHost
      and everything works immediately, without a "secrets setup" step in the README.

      For any service that connects to a SHARED resource (staging DB, cloud storage),
      use User Secrets or environment variables instead.
  */

  "Logging": {
    "LogLevel": {
      "Default":            "Debug",
      "Aspire.Hosting.Dcp": "Information"
    }
  },

  "Postgres": {
    "PgAdmin": {
      "Enabled": true
    }
  },

  "Traefik": {
    "HttpPort":      8088,
    "DashboardPort": 8081
  }
}
