## ---------------------------------------------------------------
## .gitignore for NexaCommerce — .NET 10 / Angular monorepo
## ---------------------------------------------------------------

# ── Build outputs ────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
out/
artifacts/

# ── NuGet ────────────────────────────────────────────────────────
*.nupkg
*.snupkg
.nuget/
nuget.exe
# Keep lock files — they make restores reproducible
!packages.lock.json

# ── Visual Studio ────────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/settings.json

# ── Rider ────────────────────────────────────────────────────────
.idea/
*.sln.iml

# ── MSBuild logs ─────────────────────────────────────────────────
msbuild.log
msbuild.err
msbuild.wrn

# ── Test results ─────────────────────────────────────────────────
TestResults/
*.trx
*.coverage
*.coveragexml
coverage-report/

# ── Publish ──────────────────────────────────────────────────────
publish/
**/Properties/PublishProfiles/

# ── Secrets & environment ────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.Development.*.json
secrets.json
launchSettings.json

# ── Docker ───────────────────────────────────────────────────────
docker-compose.override.yml

# ── Aspire ───────────────────────────────────────────────────────
.aspire/
aspire-manifest.json
aspire-manifest.*.json

# ── Node / Angular ───────────────────────────────────────────────
node_modules/
dist/
.angular/
.nx/cache
.nx/workspace-data
*.js.map

# ── Playwright ───────────────────────────────────────────────────
playwright-report/
test-results/
playwright/.cache/

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
